{
  "module_id": "005",
  "module_type": "ZIGBEE",
  "module_name": "STM32WB55 Zigbee Coordinator",
  "cmd_prefix": "CFZB",
  "description": "App command map for STM32WB55 Zigbee coordinator using AT commands from the STM32 module README.",
  "button_functions": [
    { "id": "MODULE_HW_RESET",      "command": "MODULE_HW_RESET",      "label": "HW Reset",      "group": "lifecycle" },
    { "id": "MODULE_SW_RESET",      "command": "MODULE_SW_RESET",      "label": "ZB Reset",      "group": "lifecycle" },
    { "id": "MODULE_GET_INFO",      "command": "MODULE_GET_INFO",      "label": "ZB Info",       "group": "network" },
    { "id": "MODULE_START_NETWORK", "command": "MODULE_START_NETWORK", "label": "Start Network", "group": "network" },
    { "id": "MODULE_STOP_NETWORK",  "command": "MODULE_STOP_NETWORK",  "label": "Stop Network",  "group": "network" },
    { "id": "MODULE_GET_NET_STATUS", "command": "MODULE_GET_NET_STATUS", "label": "Net Status", "group": "network" }
  ],
  "manual_functions": [
    {
      "id": "MODULE_SET_PERMIT_JOIN",
      "command_prefix": "MODULE_SET_PERMIT_JOIN:",
      "label": "Permit Join",
      "group": "network",
      "param_hint": "duration (0-255)",
      "example": "60"
    },
    {
      "id": "MODULE_QUERY_SHORT_ADDR",
      "command_prefix": "MODULE_QUERY_SHORT_ADDR:",
      "label": "Get Node Desc",
      "group": "discovery",
      "param_hint": "short addr, example 0x1234",
      "example": "0x1234"
    },
    {
      "id": "MODULE_QUERY_NODE_PORT_INFO",
      "command_prefix": "MODULE_QUERY_NODE_PORT_INFO:",
      "label": "Get Endpoints",
      "group": "discovery",
      "param_hint": "short addr, example 0x1234",
      "example": "0x1234"
    },
    {
      "id": "MODULE_ZCL_SEND_CONTROL_CMD",
      "command_prefix": "MODULE_ZCL_SEND_CONTROL_CMD:",
      "label": "ZCL OnOff",
      "group": "zcl",
      "param_hint": "addr,ep,cmd (0=Off,1=On,2=Toggle)",
      "example": "0x1234,01,1"
    },
    {
      "id": "MODULE_ZCL_READ_ATTR",
      "command_prefix": "MODULE_ZCL_READ_ATTR:",
      "label": "ZCL Read",
      "group": "zcl",
      "param_hint": "addr,ep,cluster,attr",
      "example": "0x1234,01,0006,0000"
    },
    {
      "id": "MODULE_ZCL_WRITE_ATTR",
      "command_prefix": "MODULE_ZCL_WRITE_ATTR:",
      "label": "ZCL Write",
      "group": "zcl",
      "param_hint": "addr,ep,cluster,attr,type,value",
      "example": "0x1234,01,0006,0000,10,01"
    }
  ],
  "response_patterns": {
    "ok": "OK",
    "error": "ERROR",
    "json_ok": "PARSE_OK",
    "json_fail": "PARSE_FAIL"
  }
}
