{
    "module_id": "004",
    "module_type": "BLE",
    "module_name": "ESP-AT BLE",
    "cmd_prefix": "CFBL",
    "description": "App command map for ESP-AT BLE module. Same 20 functions as stack_002, AT commands mapped to ESP-AT equivalents. Unsupported functions have empty command.",

    "button_functions": [
        { "id": "SW_RESET",        "command": "AT+RST",          "label": "SW Reset",       "group": "system" },
        { "id": "FACTORY_RESET",   "command": "AT+RESTORE",      "label": "Factory Reset",  "group": "system" },
        { "id": "GET_INFO",        "command": "AT+GMR",          "label": "Get Info",       "group": "info" },
        { "id": "GET_STATUS",      "command": "AT+BLECONN?",     "label": "Get Status",     "group": "info" },
        { "id": "START_BROADCAST", "command": "AT+BLEADVSTART",  "label": "Broadcast",      "group": "broadcast" },
        { "id": "WAKEUP",          "command": "MODULE_WAKEUP",   "label": "Wakeup",         "group": "system" },
        { "id": "SCAN",            "command": "AT+BLESCAN=1,3",  "label": "Scan",           "group": "scan" }
    ],

    "manual_functions": [
        { "id": "SET_NAME",          "command_prefix": "AT+BLENAME=",          "label": "Set Name",        "group": "config",     "param_hint": "device_name (max 32)",                             "example": "AT+BLENAME=ESP_Gateway" },
        { "id": "SCAN_CUSTOM",       "command_prefix": "AT+BLESCAN=",          "label": "Scan Custom",     "group": "scan",       "param_hint": "enable[,duration][,filter_type,filter_param]",     "example": "AT+BLESCAN=1,5" },
        { "id": "CONNECT",           "command_prefix": "AT+BLECONN=",          "label": "Connect",         "group": "connection", "param_hint": "conn_idx,\"addr\"[,addr_type,timeout]",            "example": "AT+BLECONN=0,\"24:0a:c4:09:34:23\"" },
        { "id": "DISCONNECT",        "command_prefix": "AT+BLEDISCONN=",       "label": "Disconnect",      "group": "connection", "param_hint": "conn_index (0-2)",                                 "example": "AT+BLEDISCONN=0" },
        { "id": "ENTER_DATA_MODE",   "command_prefix": "AT+BLESPPCFG=",        "label": "SPP Config",      "group": "connection", "param_hint": "cfg_en[,tx_srv,tx_char,rx_srv,rx_char]",           "example": "AT+BLESPPCFG=1,3,5,3,7" },
        { "id": "DISCOVER_SERVICES", "command_prefix": "AT+BLEGATTCPRIMSRV=",  "label": "Disc Services",   "group": "discovery",  "param_hint": "conn_index (0-2)",                                 "example": "AT+BLEGATTCPRIMSRV=0" },
        { "id": "DISCOVER_CHARS",    "command_prefix": "AT+BLEGATTCCHAR=",     "label": "Disc Chars",      "group": "discovery",  "param_hint": "conn_index,srv_index",                             "example": "AT+BLEGATTCCHAR=0,1" },
        { "id": "SEND_DATA",         "command_prefix": "AT+BLEGATTCWR=",       "label": "Write Char",      "group": "data",       "param_hint": "conn_idx,srv_idx,char_idx[,desc_idx],length",      "example": "AT+BLEGATTCWR=0,3,4,,6" },
        { "id": "GET_DIAGNOSTICS",   "command_prefix": "AT+BLEGATTCRD=",       "label": "Read Char",       "group": "data",       "param_hint": "conn_idx,srv_idx,char_idx[,desc_idx]",             "example": "AT+BLEGATTCRD=0,3,2" }
    ],

    "response_patterns": {
        "ok":           "OK",
        "error":        "ERROR",
        "json_ok":      "PARSE_OK",
        "json_fail":    "PARSE_FAIL"
    }
}
