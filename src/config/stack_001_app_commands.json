{
    "module_id": "001",
    "module_type": "ZIGBEE",
    "module_name": "E180-ZG120B",
    "cmd_prefix": "CFZB",
    "description": "App command map for E180-ZG120B Zigbee coordinator module. 26 functions covering lifecycle, network management, node discovery, ZCL control, and data transfer.",

    "button_functions": [
        { "id": "MODULE_HW_RESET",        "command": "MODULE_HW_RESET",        "label": "HW Reset",       "group": "lifecycle" },
        { "id": "MODULE_SW_RESET",        "command": "MODULE_SW_RESET",        "label": "SW Reset",       "group": "lifecycle" },
        { "id": "MODULE_FACTORY_RESET",   "command": "MODULE_FACTORY_RESET",   "label": "Factory Reset",  "group": "lifecycle" },
        { "id": "MODULE_GET_INFO",        "command": "MODULE_GET_INFO",        "label": "Get Info",       "group": "lifecycle" },
        { "id": "MODULE_ENTER_HEX_MODE",  "command": "MODULE_ENTER_HEX_MODE",  "label": "Enter HEX Mode", "group": "lifecycle" },
        { "id": "MODULE_START_NETWORK",   "command": "MODULE_START_NETWORK",   "label": "Start Network",  "group": "network"   },
        { "id": "MODULE_STOP_NETWORK",    "command": "MODULE_STOP_NETWORK",    "label": "Stop Network",   "group": "network"   },
        { "id": "MODULE_GET_NET_STATUS",  "command": "MODULE_GET_NET_STATUS",  "label": "Net Status",     "group": "network"   }
    ],

    "manual_functions": [
        {
            "id": "MODULE_SET_CHANNEL",
            "command_prefix": "MODULE_SET_CHANNEL:",
            "label": "Set Channel",
            "group": "network",
            "param_hint": "11-26",
            "example": "15"
        },
        {
            "id": "MODULE_SET_PANID",
            "command_prefix": "MODULE_SET_PANID:",
            "label": "Set PAN ID",
            "group": "network",
            "param_hint": "hex 4-digit",
            "example": "1A2B"
        },
        {
            "id": "MODULE_SET_TX_POWER",
            "command_prefix": "MODULE_SET_TX_POWER:",
            "label": "Set TX Power",
            "group": "network",
            "param_hint": "0-20 (dBm)",
            "example": "14"
        },
        {
            "id": "MODULE_SET_PERMIT_JOIN",
            "command_prefix": "MODULE_SET_PERMIT_JOIN:",
            "label": "Permit Join",
            "group": "network",
            "param_hint": "0-254 (seconds), 0=disable",
            "example": "60"
        },
        {
            "id": "MODULE_QUERY_SHORT_ADDR",
            "command_prefix": "MODULE_QUERY_SHORT_ADDR:",
            "label": "Query Short Addr",
            "group": "discovery",
            "param_hint": "IEEE addr 16 hex chars",
            "example": "00124B001234ABCD"
        },
        {
            "id": "MODULE_QUERY_NODE_PORT_INFO",
            "command_prefix": "MODULE_QUERY_NODE_PORT_INFO:",
            "label": "Query Node Port",
            "group": "discovery",
            "param_hint": "short addr 4 hex chars",
            "example": "1234"
        },
        {
            "id": "MODULE_DELETE_NODE",
            "command_prefix": "MODULE_DELETE_NODE:",
            "label": "Delete Node",
            "group": "discovery",
            "param_hint": "IEEE addr 16 hex chars",
            "example": "00124B001234ABCD"
        },
        {
            "id": "MODULE_ZCL_READ_ATTR",
            "command_prefix": "MODULE_ZCL_READ_ATTR:",
            "label": "ZCL Read Attr",
            "group": "zcl",
            "param_hint": "shortAddr:ep:cluster:attrId",
            "example": "1234:01:0006:0000"
        },
        {
            "id": "MODULE_ZCL_WRITE_ATTR",
            "command_prefix": "MODULE_ZCL_WRITE_ATTR:",
            "label": "ZCL Write Attr",
            "group": "zcl",
            "param_hint": "shortAddr:ep:cluster:attrId:type:value",
            "example": "1234:01:0006:0000:10:01"
        },
        {
            "id": "MODULE_ZCL_SEND_CONTROL_CMD",
            "command_prefix": "MODULE_ZCL_SEND_CONTROL_CMD:",
            "label": "ZCL Send Cmd",
            "group": "zcl",
            "param_hint": "shortAddr:ep:cluster hexPayloadBytes",
            "example": "1234:01:0006 60 A8 01 00 06"
        },
        {
            "id": "MODULE_ZCL_SET_REPORT_RULE",
            "command_prefix": "MODULE_ZCL_SET_REPORT_RULE:",
            "label": "ZCL Set Report",
            "group": "zcl",
            "param_hint": "shortAddr:ep:cluster:attrId:minIntv:maxIntv:delta",
            "example": "1234:01:0402:0000:10:60:1"
        },
        {
            "id": "MODULE_SEND_UNICAST",
            "command_prefix": "MODULE_SEND_UNICAST:",
            "label": "Send Unicast",
            "group": "data",
            "param_hint": "shortAddr:ep hexPayloadBytes",
            "example": "1234:01 AA BB CC"
        },
        {
            "id": "MODULE_SEND_BROADCAST",
            "command_prefix": "MODULE_SEND_BROADCAST:",
            "label": "Send Broadcast",
            "group": "data",
            "param_hint": "hexPayloadBytes",
            "example": "AA BB CC"
        }
    ],

    "response_patterns": {
        "ok":        "OK",
        "error":     "ERROR",
        "json_ok":   "PARSE_OK",
        "json_fail": "PARSE_FAIL"
    }
}
